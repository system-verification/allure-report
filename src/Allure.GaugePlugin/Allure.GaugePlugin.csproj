<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- No static files are served; stops publish emitting an empty staticwebassets manifest. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Grpc.AspNetCore.Server" Version="2.80.0" />
  </ItemGroup>

  <!--
    The C# for Gauge's protocol is generated into GrpcMessages/Generated and committed, so regular builds don't
    run protoc (the linux-arm64 protoc in Grpc.Tools crashes on GitHub's arm64 runners).
    After updating the .proto files, regenerate with:  dotnet build src/Allure.GaugePlugin -p:GenerateProto=true
  -->
  <ItemGroup Condition="'$(GenerateProto)' == 'true'">
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="all" />
    <!-- protoc compiles its fresh outputs itself, so leave the committed copies out of the build. -->
    <Compile Remove="GrpcMessages\Generated\**" />
    <Protobuf Include="GrpcMessages\messages.proto;GrpcMessages\spec.proto" ProtoRoot="GrpcMessages" GrpcServices="None" OutputDir="GrpcMessages\Generated" />
    <Protobuf Include="GrpcMessages\services.proto" ProtoRoot="GrpcMessages" GrpcServices="Server" OutputDir="GrpcMessages\Generated" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Allure.GaugePlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
